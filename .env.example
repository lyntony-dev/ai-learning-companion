# AI 学习伙伴 —— 本地开发环境模板
# 用法:复制为 .env(仓库根)与 scaffold/apps/api/.env,按需填值。
# 真实 .env 已被 .gitignore 忽略,仅此 .example 入库,切勿把真实 key 提交。
#
# 说明:后端用 pydantic-settings 读取,未设置的项一律用 app/core/config.py 中的默认值。
# 本地开发把 APP_ENV 设为 local 即可;鉴权密钥用 dev 占位可直接跑。

# === 运行环境 ===
APP_ENV=local              # local | production;production 时 dev 占位密钥会 fail-fast 拒绝启动
APP_LOG_LEVEL=INFO

# === 存储 ===
DATABASE_URL=sqlite:///data/app.sqlite            # 脚手架库(课程/切片/会话/trace/eval)
BUSINESS_DB_URL=sqlite:///data/business.sqlite    # 业务库(学习者/掌握度/训练/结课, ADR-0005)
CHROMA_PERSIST_DIR=data/chroma

# === 鉴权(ADR-0008/0009)===
# 讲师注册需要邀请码,学生自由注册。以下为 dev 占位,本地可直接用;
# APP_ENV=production 时若仍是占位值,后端启动即失败。
AUTH_TOKEN_SECRET=dev-insecure-secret-change-me   # 自签 token 签名密钥(非 JWT)
AUTH_TEACHER_INVITE_CODE=dev-teacher-invite       # ← 讲师注册邀请码(默认值)
AUTH_TOKEN_TTL_HOURS=168                           # token 有效期(小时)

# === LLM(火山方舟 Ark,OpenAI 兼容 /chat/completions;不填走 mock)===
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=                                       # 填你的 Ark key
LLM_MODEL=                                          # 填你的推理接入点 ep-xxxx
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# === Embedding(doubao-embedding-vision,必须走 /embeddings/multimodal)===
# ⚠️ EMBEDDING_DIM 必须与已建 Chroma 索引一致(本项目 2048),否则检索报维度不匹配
EMBEDDING_PROVIDER=ark_multimodal
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=                                  # 填你的 Ark key
EMBEDDING_MODEL=                                    # 填你的 embedding 接入点 ep-xxxx
EMBEDDING_DIM=2048
EMBEDDING_BATCH_SIZE=16

# === CORS(默认走 nginx 同源反代,留空即可;前后端分离到不同域才填)===
CORS_ALLOW_ORIGINS=                                 # 逗号分隔,如 https://a.com,https://b.com

# === 检索/生成重试上限(引擎通用策略,与课程无关)===
MAX_RETRIEVAL_RETRY=1
MAX_GENERATE_RETRY=1

# === Trace ===
TRACE_DEBUG_FULL=true
