APP_ENV=local
APP_LOG_LEVEL=INFO

DATABASE_URL=sqlite:///data/app.sqlite
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=data/chroma
COURSE_MATERIALS_DIR=data/course_materials

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_API_KEY=

LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

TRACE_DEBUG_FULL=false
MAX_RETRIEVAL_RETRY=1
MAX_GENERATE_RETRY=1

DEFAULT_USER_ID=demo_user
