# AI Agent 学习伙伴 —— 部署环境模板(复制为 deploy/.env.deploy 后填值)
# 已被 .gitignore 忽略实际的 .env.deploy(仅此 .example 入库)。

# --- 运行环境 ---
APP_ENV=production
APP_LOG_LEVEL=INFO

# --- 存储(容器内路径,由 compose volume 持久化)---
BUSINESS_DB_URL=sqlite:///data/business.sqlite
DATABASE_URL=sqlite:///data/app.sqlite
CHROMA_PERSIST_DIR=data/chroma

# --- 安全密钥(生产必须覆盖!APP_ENV=production 时用 dev 默认值会启动失败)---
AUTH_TOKEN_SECRET=CHANGE_ME_to_a_long_random_secret
AUTH_TEACHER_INVITE_CODE=CHANGE_ME_teacher_invite_code
AUTH_TOKEN_TTL_HOURS=168

# --- CORS(默认走 nginx 同源反代,留空即可;前后端分离才填)---
CORS_ALLOW_ORIGINS=

# --- LLM(火山方舟 Ark,OpenAI 兼容 /chat/completions;不填走 mock)---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Embedding(doubao-embedding-vision,必须走 /embeddings/multimodal)---
# ⚠️ EMBEDDING_DIM 必须与已建 Chroma 索引一致(本项目 2048)
EMBEDDING_PROVIDER=ark_multimodal
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048
EMBEDDING_BATCH_SIZE=16
